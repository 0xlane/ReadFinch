{
  "name": "readfinch",
  "productName": "ReadFinch",
  "version": "1.2.6",
  "description": "A desktop reading and writing companion: select, translate, understand and save. 伴读雀：随选随用的桌面阅读与写作助手。",
  "author": "ReadFinch contributors",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "desktopName": "app.readfinch.ReadFinch.desktop",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:commands": "node scripts/action-schema-smoke.mjs",
    "test:suggestions": "node scripts/suggestion-smoke.mjs",
    "test:reasoning": "node scripts/reasoning-smoke.mjs",
    "test:panels": "node scripts/panel-smoke.mjs",
    "test:input": "node scripts/input-flow.mjs",
    "test:shortcuts": "node scripts/shortcut-smoke.mjs",
    "test:toolbar": "node scripts/toolbar-smoke.mjs",
    "test:speech": "node scripts/speech-smoke.mjs",
    "test:startup": "node scripts/startup-smoke.mjs",
    "test:settings": "node scripts/settings-smoke.mjs",
    "test:credentials": "node scripts/credentials-smoke.mjs",
    "test:upgrade": "node scripts/upgrade-smoke.mjs",
    "test:ocr": "node --require ./scripts/block-network.cjs --import tsx scripts/verify-ocr.ts",
    "test:native": "node scripts/native-smoke.mjs",
    "test:macos": "node scripts/macos-smoke.mjs",
    "test:selection": "node scripts/selection-compatibility-smoke.mjs",
    "test:selection:java": "node scripts/java-selection-smoke.mjs",
    "test:updates": "node scripts/update-ui-smoke.mjs",
    "test:packaged": "node scripts/packaged-smoke.mjs",
    "assets:ocr": "node scripts/download-ocr.mjs",
    "native:build": "node scripts/build-native.mjs",
    "signing:check": "node scripts/macos-signing.mjs check",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "format": "prettier --write src scripts tests vite.config.ts package.json tsconfig.json",
    "fixtures": "node scripts/fixtures-server.mjs",
    "schema": "tsx scripts/schema.ts",
    "docs:readme": "node scripts/readmes.mjs",
    "models:sync": "node scripts/sync-provider-catalog.mjs"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.113",
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/azure": "4.0.99",
    "@ai-sdk/cohere": "4.0.59",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/open-responses": "2.0.63",
    "@ai-sdk/provider": "4.0.26",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-liquid": "^6.3.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "ai-sdk-ollama": "4.4.0",
    "codemirror": "^6.0.2",
    "diff": "^8.0.2",
    "dompurify": "^3.4.17",
    "electron-updater": "6.8.11",
    "franc": "6.2.0",
    "liquidjs": "^10.30.1",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.27.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "app.readfinch.ReadFinch",
    "publish": [
      {
        "provider": "github",
        "owner": "0xlane",
        "repo": "ReadFinch",
        "releaseType": "release"
      }
    ],
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "**/*",
          "!**/*.pdb"
        ]
      },
      {
        "from": "assets/ocr",
        "to": "ocr"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "icon": "src/renderer/public/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "ReadFinch-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ReadFinch",
      "uninstallDisplayName": "ReadFinch ${version}"
    },
    "portable": {
      "artifactName": "ReadFinch-${version}-windows-${arch}-portable.${ext}"
    },
    "mac": {
      "artifactName": "ReadFinch-${version}-macos-${arch}.${ext}",
      "identity": "-",
      "sign": "scripts/sign-macos.mjs",
      "notarize": false,
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "ReadFinch captures only the region you choose for OCR.",
        "NSAppleEventsUsageDescription": "ReadFinch reads selections after you enable accessibility."
      }
    },
    "linux": {
      "maintainer": "ReadFinch contributors",
      "artifactName": "ReadFinch-${version}-linux-${arch}.${ext}",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "executableName": "readfinch",
      "desktop": {
        "entry": {
          "Name": "ReadFinch",
          "StartupWMClass": "app.readfinch.ReadFinch"
        }
      },
      "syncDesktopName": true
    },
    "icon": "src/renderer/public/icon.png"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0xlane/ReadFinch.git"
  },
  "homepage": "https://github.com/0xlane/ReadFinch#readme",
  "bugs": {
    "url": "https://github.com/0xlane/ReadFinch/issues"
  }
}
